# Variables d'environnement — Frontend Signature Immersion
# Copier ce fichier en .env.local et renseigner des valeurs réelles.
# Ne jamais committer .env.local (déjà exclu via .gitignore).

# URL du backend ASP.NET Core (API).
# Utilisée par lib/api.ts (tous les appels API), next.config.ts (CSP connect-src),
# les pages /embed et le dashboard (upload de contrat).
# Dev : port réel du backend en local (voir Signature3D.Api/Program.cs, UseUrls).
# Obligatoire sur Vercel (Preview et Production) : sans elle, le build échoue
# volontairement (voir lib/env.ts) plutôt que d'appeler localhost en production.
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL publique de ce site (utilisée pour générer robots.txt et sitemap.xml).
# À configurer sur Vercel avec le domaine réel une fois celui-ci défini.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL publique du frontend, utilisée dans le dashboard pour construire les liens
# directs et QR codes des visites immersives (/embed/{slug}) ainsi que le script
# d'intégration du widget Luxedia (ProjectLinkModal, page client).
# À configurer sur Vercel avec le domaine réel une fois celui-ci défini.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Interrupteur de staging (voir proxy.ts) — variable serveur uniquement (jamais exposée
# au navigateur, pas de préfixe NEXT_PUBLIC_ nécessaire puisqu'elle n'est lue que dans
# proxy.ts/robots.ts/sitemap.ts, jamais dans un composant client).
# true (ou absente) : comportement normal, site public accessible.
# false : site public masqué derrière une page d'attente — le dashboard et /embed/*
# restent entièrement fonctionnels. À repasser à "true" (ou retirer) pour l'ouverture
# officielle du site, sans autre changement de code.
PUBLIC_SITE_ENABLED=true
